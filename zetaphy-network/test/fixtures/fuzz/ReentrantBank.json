{
 "version": 2,
 "name": "ReentrantBank (fuzz fixture)",
 "note": "TEST ONLY. Reentrancy: withdraw() pays before it zeroes the balance.",
 "functions": [
  {
   "sig": "deposit()",
   "payable": true
  },
  {
   "sig": "withdraw()"
  },
  {
   "sig": "balances(address)"
  }
 ],
 "setup": [
  {
   "from": "victim",
   "sig": "deposit()",
   "value": "5000000000000000000"
  }
 ],
 "exit": [
  {
   "sig": "withdraw()",
   "args": []
  }
 ],
 "exitMin": "5000000000000000000",
 "solvency": "balances(address)",
 "initcode": "",
 "balances": {
  "deployer": "10000000000000000000",
  "victim": "10000000000000000000",
  "attacker": "2000000000000000000"
 },
 "invariants": [
  "attacker-profit",
  "victim-can-exit",
  "balance-conservation",
  "privileged-unchanged",
  "no-selfdestruct",
  "no-delegatecall-to-attacker",
  "token-drain"
 ],
 "minProfit": "1000000000000000000",
 "hook": true,
 "expect": [
  "attacker-profit",
  "victim-can-exit",
  "balance-conservation",
  "reentrancy"
 ]
}
