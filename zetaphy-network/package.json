{
  "name": "zetaphy-network",
  "version": "0.1.0",
  "private": true,
  "description": "ZETAPHY stage 1-2: Neuro job market contract, node runner CLI and worker",
  "type": "module",
  "bin": {
    "zetaphy": "./cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:devnet": "node --test test/devnet.integration.js",
    "test:devnet:pq": "node --test test/devnet.pq.integration.js",
    "test:devnet:bridge": "node --test test/devnet.bridge.integration.js",
    "test:devnet:pqcert": "node --test test/devnet.pqcert.integration.js",
    "test:devnet:cosmoswallet": "node --test test/devnet.cosmoswallet.integration.js",
    "test:devnet:neurogov": "node --test test/devnet.neurogov.integration.js",
    "test:devnet:chainrand": "node --test test/devnet.chainrand.integration.js",
    "test:devnet:preinstalls": "node --test test/devnet.preinstalls.integration.js",
    "test:devnet:ibc": "node --test test/devnet.ibc.integration.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "~2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/evm": "^3.1.1",
    "@ethereumjs/util": "^9.1.0",
    "cosmjs-types": "^0.11.0",
    "solc": "0.8.26"
  }
