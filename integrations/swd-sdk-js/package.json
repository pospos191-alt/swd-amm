{
  "name": "swd-sdk",
  "version": "0.1.0",
  "description": "Tiny client for the public SWD (SAWASDEE COIN) APIs: SWD Audit (contracts on 14 chains, transactions), SWD supply, the Buy SWD Solana Action and attestation checks. No dependencies, no keys.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.th.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --clean --format cjs,esm --out-dir dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "solana",
    "swd",
    "sawasdee",
    "audit",
    "security",
    "solana-actions",
    "blinks",
    "sdk"
  ],
  "homepage": "https://swd-zetaphy.sawasdeecoin.com/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/pospos191-alt/zetaphy",
    "directory": "integrations/swd-sdk-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
