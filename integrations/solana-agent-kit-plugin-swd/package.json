{
  "name": "solana-agent-kit-plugin-swd",
  "version": "0.1.0",
  "description": "SWD (SAWASDEE COIN) tools for Solana Agent Kit v2: free contract audits on 14 chains, transaction scam checks, token info and Solana swap quotes. Read-only.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --clean --format cjs,esm --out-dir dist",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["solana-agent-kit", "solana", "ai-agent", "audit", "security", "swd", "mcp"],
  "homepage": "https://swd-zetaphy.sawasdeecoin.com/developers#mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/pospos191-alt/zetaphy",
    "directory": "integrations/solana-agent-kit-plugin-swd"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "solana-agent-kit": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "solana-agent-kit": "^2.0.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
