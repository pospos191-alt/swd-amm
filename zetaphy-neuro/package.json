{
  "name": "zetaphy-neuro",
  "version": "0.1.0",
  "private": true,
  "description": "Neuro ZETAPHY tier 1: read-only token and contract reader and explainer for EVM chains, Solana, Sui, Aptos, TON and CosmWasm, in 9 languages",
  "license": "BUSL-1.1",
  "type": "module",
  "bin": {
    "zetaphy-neuro": "./cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "selectors": "node scripts/build-selectors.js",
    "tradesim": "node scripts/build-tradesim.js",
    "threat-signatures": "node scripts/build-threat-signatures.js",
    "web": "node scripts/serve.js",
    "test:web": "node --test test/web.e2e.js test/ai.e2e.js test/graph.e2e.js test/browserai.e2e.js ml/test/fl.browser.e2e.js",
    "model-pack": "node scripts/build-model-pack.js",
    "test:ml": "node --test ml/test/*.test.js",
    "ml:corpus": "node ml/data/build-corpus.js",
    "ml:train": "node ml/train/train.js",
    "ml:redteam": "node ml/redteam/run.js",
    "ml:fl:simulate": "node ml/fl/simulate.js",
    "ml:fl:manifest": "node ml/fl/manifest.js",
    "graph": "node agent/cli.js graph",
    "investigate": "node agent/cli.js investigate",
    "scan-pools": "node agent/cli.js scan-pools"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/evm": "^3.1.1",
    "@ethereumjs/util": "^9.1.0",
    "@noble/hashes": "1.5.0",
    "@solana/web3.js": "^1.95.4",
    "playwright-core": "^1.56.1",
    "solc": "0.8.26"
  },
  "overrides": {
    "tmp": "0.2.7",
    "jayson": "5.0.0"
  }
}
